# Server-to-Server OAuth (Zoom Marketplace -> Develop -> Build App -> Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=tu_account_id
ZOOM_CLIENT_ID=tu_client_id
ZOOM_CLIENT_SECRET=tu_client_secret

# Host de las reuniones: "me" o el email del usuario dueño
ZOOM_USER_ID=me

# Opcional: Secret Token del webhook (Feature > Event Subscriptions).
# Solo necesario si activas webhooks para verificar los eventos entrantes.
ZOOM_SECRET_TOKEN=
